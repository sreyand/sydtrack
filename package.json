{
  "name": "sydtrack",
  "version": "2.5.0",
  "description": "Desktop productivity tracker — active window time, classification, and focus reminders",
  "main": "src/main.js",
  "author": "sydtrack",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "node scripts/start.js",
    "start:electron": "electron . --disable-gpu",
    "start:demo": "node scripts/start.js --demo",
    "postinstall": "node scripts/ensure-install-scripts.js",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/check-syntax.js && node scripts/test-classification.js && node scripts/test-category-explanation.js && node scripts/smoke.js && node scripts/test-hardening.js && node scripts/test-main-security.js && node scripts/test-storage.js && node scripts/test-desktop-preferences.js && node scripts/test-start.js && node scripts/test-startup.js && node scripts/test-profile-shortcut.js && node scripts/test-window-shortcut.js && node scripts/test-theme-rotation.js && node scripts/test-live-ticker.js && node scripts/test-timed-pause.js && node scripts/test-break-reminder.js && node scripts/test-timeline.js && node scripts/test-other-inbox.js && node scripts/test-apps-analytics.js && node scripts/test-session-intention.js && node scripts/test-quick-corrections.js && node scripts/test-updates.js && node scripts/test-tray.js",
    "test:start": "node scripts/test-start.js",
    "test:hardening": "node scripts/test-hardening.js",
    "generate:activity": "node scripts/generate-activity.js",
    "sync:profiles": "node scripts/sync-focus-presets.js",
    "benchmark:storage": "node scripts/benchmark-storage.js",
    "benchmark:classification": "node scripts/benchmark-classification.js",
    "test:ui": "node scripts/check-ui.js && node scripts/check-score-navigation.js && node scripts/check-pause-menu.js && node scripts/check-schedule-time.js && node scripts/check-select-menu.js && node scripts/check-dom-patch.js",
    "test:select-menu": "node scripts/check-select-menu.js",
    "test:dom-patch": "node scripts/check-dom-patch.js",
    "test:score-navigation": "node scripts/check-score-navigation.js",
    "test:pause-menu": "node scripts/check-pause-menu.js",
    "test:schedule-time": "node scripts/check-schedule-time.js",
    "test:profiles-ui": "node scripts/check-profiles-ui.js",
    "test:packaged": "node scripts/check-packaged.js",
    "test:tray": "node scripts/test-tray.js",
    "test:tray-native": "node scripts/check-tray.js",
    "test:windows-backend": "node scripts/test-win.js",
    "pack": "node scripts/dist.js dir",
    "dist": "node scripts/dist.js win",
    "dist:win": "node scripts/dist.js win",
    "dist:mac": "node scripts/dist.js mac",
    "dist:linux": "node scripts/dist.js linux",
    "dist:portable": "node scripts/dist.js portable"
  },
  "dependencies": {
    "active-win": "^8.1.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "electron": true,
    "electron@28.3.3": true,
    "active-win": true,
    "active-win@8.2.1": true
  },
  "build": {
    "appId": "com.gitpaperclip.sydtrack",
    "productName": "sydtrack",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.DELETE.*"
    ],
    "asar": true,
    "publish": null,
    "extraResources": [
      { "from": "renderer/assets/sydtrack.ico", "to": "sydtrack.ico" },
      { "from": "scripts/get-foreground.ps1", "to": "get-foreground.ps1" },
      { "from": "scripts/get-browser-address.ps1", "to": "get-browser-address.ps1" }
    ],
    "win": {
      "icon": "renderer/assets/sydtrack.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "sydtrack-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "sydtrack-${version}-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "sydtrack <noreply@sydtrack.app>",
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
